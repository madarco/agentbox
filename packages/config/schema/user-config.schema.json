{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-box.sh/schema/user-config.schema.json",
  "title": "AgentBox user config",
  "description": "Layered defaults for the agentbox CLI. Same shape lives in ~/.agentbox/config.yaml (global), ~/.agentbox/projects/<hash>/config.yaml (per-project user), and the `defaults:` block of agentbox.yaml (committed project policy).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "box": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "oneOf": [
            {
              "enum": [
                "docker",
                "daytona",
                "hetzner",
                "vercel",
                "e2b",
                "digitalocean",
                "remote-docker"
              ]
            },
            {
              "type": "string",
              "pattern": "^(?:docker|remote-docker):[A-Za-z0-9][A-Za-z0-9._@:-]*$",
              "description": "A host-qualified engine spec, e.g. `docker:hub`."
            }
          ],
          "description": "Sandbox backend new boxes are created on. Overridden per-run by --provider. Also accepts a `docker:<host>` spec naming a registered remote-docker engine."
        },
        "hostSnapshot": {
          "type": "boolean"
        },
        "defaultCheckpoint": {
          "type": "string",
          "minLength": 1
        },
        "defaultCheckpointDocker": {
          "type": "string",
          "minLength": 1
        },
        "defaultCheckpointDaytona": {
          "type": "string",
          "minLength": 1
        },
        "defaultCheckpointHetzner": {
          "type": "string",
          "minLength": 1
        },
        "defaultCheckpointVercel": {
          "type": "string",
          "minLength": 1
        },
        "defaultCheckpointE2b": {
          "type": "string",
          "minLength": 1
        },
        "defaultCheckpointDigitalocean": {
          "type": "string",
          "minLength": 1
        },
        "defaultCheckpointRemoteDocker": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "type": "string",
          "minLength": 1
        },
        "sizeDocker": {
          "type": "string",
          "minLength": 1
        },
        "sizeDaytona": {
          "type": "string",
          "minLength": 1
        },
        "sizeHetzner": {
          "type": "string",
          "minLength": 1
        },
        "sizeVercel": {
          "type": "string",
          "minLength": 1
        },
        "sizeE2b": {
          "type": "string",
          "minLength": 1
        },
        "sizeDigitalocean": {
          "type": "string",
          "minLength": 1
        },
        "sizeRemoteDocker": {
          "type": "string",
          "minLength": 1
        },
        "withPlaywright": {
          "type": "boolean"
        },
        "withEnv": {
          "type": "boolean"
        },
        "resyncOnStart": {
          "type": "boolean"
        },
        "vnc": {
          "type": "boolean"
        },
        "autoApproveHostActions": {
          "type": "boolean"
        },
        "persistent": {
          "type": "boolean"
        },
        "autoApproveSafeHostActions": {
          "type": "boolean"
        },
        "isolateClaudeConfig": {
          "type": "boolean"
        },
        "isolateCodexConfig": {
          "type": "boolean"
        },
        "isolateOpencodeConfig": {
          "type": "boolean"
        },
        "isolatePiConfig": {
          "type": "boolean"
        },
        "isolateExampleConfig": {
          "type": "boolean"
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "imageDocker": {
          "type": "string",
          "minLength": 1
        },
        "imageDaytona": {
          "type": "string",
          "minLength": 1
        },
        "imageHetzner": {
          "type": "string",
          "minLength": 1
        },
        "imageVercel": {
          "type": "string",
          "minLength": 1
        },
        "imageE2b": {
          "type": "string",
          "minLength": 1
        },
        "imageDigitalocean": {
          "type": "string",
          "minLength": 1
        },
        "imageRemoteDocker": {
          "type": "string",
          "minLength": 1
        },
        "imageRegistry": {
          "type": "string"
        },
        "e2bTimeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "credentialSync": {
          "type": "boolean"
        },
        "dockerCacheShared": {
          "type": "boolean"
        },
        "memory": {
          "type": "integer",
          "minimum": 0
        },
        "cpus": {
          "type": "integer",
          "minimum": 0
        },
        "pidsLimit": {
          "type": "integer",
          "minimum": 0
        },
        "disk": {
          "type": "string"
        },
        "bundleDepth": {
          "type": "integer",
          "minimum": 0
        },
        "daytonaClass": {
          "type": "string",
          "enum": ["linux-vm", "container"]
        },
        "daytonaRegion": {
          "type": "string",
          "minLength": 1
        },
        "daytonaTimeoutMs": {
          "type": "integer",
          "minimum": 0
        },
        "daytonaVmBaseImage": {
          "type": "string",
          "minLength": 1
        },
        "hetznerLocation": {
          "type": "string",
          "minLength": 1
        },
        "digitaloceanRegion": {
          "type": "string",
          "minLength": 1
        },
        "digitaloceanProject": {
          "type": "string",
          "minLength": 1
        },
        "remoteDockerHost": {
          "type": "string",
          "minLength": 1
        },
        "inbound": {
          "type": "string",
          "minLength": 1
        },
        "swap": {
          "type": "string",
          "pattern": "^\\s*(?:[Aa][Uu][Tt][Oo]|[Oo][Nn]|[Oo][Ff][Ff]|[Nn][Oo][Nn][Ee]|0|[0-9]+\\s*[MmGg])\\s*$"
        },
        "vercelTimeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "vercelNetworkPolicy": {
          "type": "string"
        },
        "cpMaxBytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxLayers": {
          "type": "integer"
        }
      }
    },
    "claude": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionName": {
          "type": "string",
          "minLength": 1
        },
        "dangerouslySkipPermissions": {
          "type": "boolean"
        },
        "install": {
          "enum": ["native", "npm"]
        },
        "tui": {
          "enum": ["default", "fullscreen", "auto"]
        },
        "account": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$",
          "description": "Named LLM account new boxes of this agent run on; default is the plain login. Global or per-project config only."
        }
      }
    },
    "codex": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionName": {
          "type": "string",
          "minLength": 1
        },
        "dangerouslySkipPermissions": {
          "type": "boolean"
        },
        "account": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$",
          "description": "Named LLM account new boxes of this agent run on; default is the plain login. Global or per-project config only."
        }
      }
    },
    "opencode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionName": {
          "type": "string",
          "minLength": 1
        },
        "modelAuth": {
          "type": "string",
          "pattern": "^(none|codex(,codex)*)$"
        }
      }
    },
    "pi": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionName": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^(?![xX]$)((0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?|[A-Za-z][A-Za-z0-9._-]*)$"
        },
        "modelAuth": {
          "type": "string",
          "pattern": "^(none|codex(,codex)*)$"
        }
      }
    },
    "openclaw": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionName": {
          "type": "string",
          "minLength": 1
        },
        "modelAuth": {
          "type": "string",
          "pattern": "^(none|codex(,codex)*)$"
        }
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionName": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "attach": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "openIn": {
          "enum": ["split", "window", "tab", "same"]
        },
        "cmuxStatus": {
          "type": "boolean"
        },
        "herdrStatus": {
          "type": "boolean"
        }
      }
    },
    "manager": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "carrier": {
          "enum": ["auto", "pty", "tmux"]
        },
        "lifetime": {
          "enum": ["leased", "persistent"]
        },
        "leaseGraceSeconds": {
          "type": "integer"
        },
        "scrollbackBytes": {
          "type": "integer"
        },
        "windowSize": {
          "enum": ["latest", "smallest", "largest"]
        },
        "submitDelayMs": {
          "type": "integer"
        },
        "detachKey": {
          "type": "string"
        }
      }
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ide": {
          "enum": ["vscode", "cursor", "auto"]
        },
        "wait": {
          "type": "boolean"
        },
        "timeoutMs": {
          "type": "integer"
        },
        "autoTerminals": {
          "type": "boolean"
        }
      }
    },
    "shell": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user": {
          "type": "string",
          "minLength": 1
        },
        "login": {
          "type": "boolean"
        },
        "tmux": {
          "type": "boolean"
        }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["orbstack", "docker-desktop", "other", "auto"]
        }
      }
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": {
          "enum": ["agent-browser", "playwright", "both"]
        }
      }
    },
    "relay": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer"
        },
        "controlPlaneUrl": {
          "type": "string"
        },
        "custodyMaxBodyBytes": {
          "type": "integer"
        },
        "custodyMaxBlobBytes": {
          "type": "integer"
        },
        "hostReachTimeoutMs": {
          "type": "integer"
        }
      }
    },
    "share": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endpoint": {
          "type": "string"
        }
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxSkillBytes": {
          "type": "integer"
        }
      }
    },
    "ssh": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "autoConfig": {
          "type": "boolean"
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pushMode": {
          "enum": ["auto", "relay", "lease", "direct"]
        }
      }
    },
    "accounts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "onLimit": {
          "enum": ["ask", "switch"]
        }
      }
    },
    "llm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "proxy": {
          "enum": ["off", "forward"]
        },
        "proxyPort": {
          "type": "integer"
        },
        "proxyUrl": {
          "type": "string"
        }
      }
    },
    "hub": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gitAuth": {
          "enum": ["gh", "app"]
        },
        "mode": {
          "enum": ["auto", "thin", "local"]
        }
      }
    },
    "cloud": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "useCurrentBranch": {
          "type": "boolean"
        },
        "viaHub": {
          "type": "boolean"
        }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gh": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "vnc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "containerPort": {
          "type": "integer"
        }
      }
    },
    "portless": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "stateDir": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "autopause": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxRunningBoxes": {
          "type": "integer"
        },
        "idleMinutes": {
          "type": "integer"
        }
      }
    },
    "queue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxConcurrent": {
          "type": "integer"
        },
        "maxWorking": {
          "type": "integer"
        },
        "idleGraceSeconds": {
          "type": "integer"
        },
        "openIn": {
          "enum": ["none", "split", "window", "tab"]
        }
      }
    },
    "maintenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pruneProjectConfigs": {
          "type": "boolean"
        },
        "pruneProjectConfigsEvery": {
          "type": "integer"
        }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "description": "Session history in the hub (see agentbox docs: configuration#history).",
      "properties": {
        "capture": {
          "type": "boolean",
          "description": "Ship this project's box transcripts to the hub (default true)."
        },
        "retentionDays": {
          "type": "integer",
          "minimum": 1,
          "description": "Days the hub keeps a session after its last activity (default 90)."
        },
        "hostSessions": {
          "type": "boolean",
          "description": "Ship this PC's own (non-box) agent sessions to the hub (default false). Global: the toggle; project: allow (true) / deny (false)."
        },
        "materialize": {
          "type": "boolean",
          "description": "Write box claude sessions from the hub into this PC's ~/.claude/projects/<project>/ so claude --resume lists them (default true). Global, or per project."
        },
        "contributeUsage": {
          "type": "boolean",
          "description": "With a remote control box configured, push this PC's usage metrics (ids and numbers, never transcripts) to it so its Usage page counts this PC's boxes and sessions (default true)."
        }
      }
    },
    "update": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "check": {
          "type": "boolean"
        },
        "channel": {
          "enum": ["auto", "stable", "nightly"]
        },
        "registry": {
          "type": "string"
        }
      }
    }
  }
}
