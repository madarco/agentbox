{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-box.sh/schema/user-config.schema.json",
  "title": "AgentBox user config",
  "description": "Layered defaults for the agentbox CLI. Same shape lives in ~/.agentbox/config.yaml (global), ~/.agentbox/projects/<hash>/config.yaml (per-project user), and the `defaults:` block of agentbox.yaml (committed project policy).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "box": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "oneOf": [
            {
              "enum": [
                "docker",
                "daytona",
                "hetzner",
                "vercel",
                "e2b",
                "digitalocean",
                "remote-docker"
              ]
            },
            {
              "type": "string",
              "pattern": "^(?:docker|remote-docker):[A-Za-z0-9][A-Za-z0-9._@:-]*$",
              "description": "A host-qualified engine spec, e.g. `docker:hub`."
            }
          ],
          "description": "Sandbox backend new boxes are created on. Overridden per-run by --provider. Also accepts a `docker:<host>` spec naming a registered remote-docker engine."
        },
        "hostSnapshot": { "type": "boolean" },
        "defaultCheckpoint": { "type": "string", "minLength": 1 },
        "defaultCheckpointDocker": { "type": "string", "minLength": 1 },
        "defaultCheckpointDaytona": { "type": "string", "minLength": 1 },
        "defaultCheckpointHetzner": { "type": "string", "minLength": 1 },
        "defaultCheckpointVercel": { "type": "string", "minLength": 1 },
        "defaultCheckpointE2b": { "type": "string", "minLength": 1 },
        "defaultCheckpointDigitalocean": { "type": "string", "minLength": 1 },
        "defaultCheckpointRemoteDocker": { "type": "string", "minLength": 1 },
        "size": { "type": "string", "minLength": 1 },
        "sizeDocker": { "type": "string", "minLength": 1 },
        "sizeDaytona": { "type": "string", "minLength": 1 },
        "sizeHetzner": { "type": "string", "minLength": 1 },
        "sizeVercel": { "type": "string", "minLength": 1 },
        "sizeE2b": { "type": "string", "minLength": 1 },
        "sizeDigitalocean": { "type": "string", "minLength": 1 },
        "sizeRemoteDocker": { "type": "string", "minLength": 1 },
        "withPlaywright": { "type": "boolean" },
        "withEnv": { "type": "boolean" },
        "resyncOnStart": { "type": "boolean" },
        "vnc": { "type": "boolean" },
        "autoApproveHostActions": { "type": "boolean" },
        "autoApproveSafeHostActions": { "type": "boolean" },
        "isolateClaudeConfig": { "type": "boolean" },
        "isolateCodexConfig": { "type": "boolean" },
        "isolateOpencodeConfig": { "type": "boolean" },
        "isolatePiConfig": { "type": "boolean" },
        "isolateExampleConfig": { "type": "boolean" },
        "image": { "type": "string", "minLength": 1 },
        "imageDocker": { "type": "string", "minLength": 1 },
        "imageDaytona": { "type": "string", "minLength": 1 },
        "imageHetzner": { "type": "string", "minLength": 1 },
        "imageVercel": { "type": "string", "minLength": 1 },
        "imageE2b": { "type": "string", "minLength": 1 },
        "imageDigitalocean": { "type": "string", "minLength": 1 },
        "imageRemoteDocker": { "type": "string", "minLength": 1 },
        "imageRegistry": { "type": "string" },
        "e2bTimeoutMs": { "type": "integer", "minimum": 1 },
        "credentialSync": { "type": "boolean" },
        "dockerCacheShared": { "type": "boolean" },
        "memory": { "type": "integer", "minimum": 0 },
        "cpus": { "type": "integer", "minimum": 0 },
        "pidsLimit": { "type": "integer", "minimum": 0 },
        "disk": { "type": "string" },
        "bundleDepth": { "type": "integer", "minimum": 0 },
        "daytonaClass": { "type": "string", "enum": ["linux-vm", "container"] },
        "daytonaRegion": { "type": "string", "minLength": 1 },
        "daytonaTimeoutMs": { "type": "integer", "minimum": 0 },
        "daytonaVmBaseImage": { "type": "string", "minLength": 1 },
        "hetznerLocation": { "type": "string", "minLength": 1 },
        "digitaloceanRegion": { "type": "string", "minLength": 1 },
        "digitaloceanProject": { "type": "string", "minLength": 1 },
        "remoteDockerHost": { "type": "string", "minLength": 1 },
        "inbound": { "type": "string", "minLength": 1 },
        "vercelTimeoutMs": { "type": "integer", "minimum": 1 },
        "vercelNetworkPolicy": { "type": "string" },
        "cpMaxBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxLayers": { "type": "integer" }
      }
    },
    "claude": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionName": { "type": "string", "minLength": 1 },
        "dangerouslySkipPermissions": { "type": "boolean" },
        "install": { "enum": ["native", "npm"] },
        "tui": { "enum": ["default", "fullscreen", "auto"] }
      }
    },
    "codex": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionName": { "type": "string", "minLength": 1 },
        "dangerouslySkipPermissions": { "type": "boolean" }
      }
    },
    "opencode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionName": { "type": "string", "minLength": 1 }
      }
    },
    "pi": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionName": { "type": "string", "minLength": 1 }
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionName": { "type": "string", "minLength": 1 }
      }
    },
    "attach": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "openIn": { "enum": ["split", "window", "tab", "same"] },
        "cmuxStatus": { "type": "boolean" },
        "herdrStatus": { "type": "boolean" }
      }
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ide": { "enum": ["vscode", "cursor", "auto"] },
        "wait": { "type": "boolean" },
        "timeoutMs": { "type": "integer" },
        "autoTerminals": { "type": "boolean" }
      }
    },
    "shell": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user": { "type": "string", "minLength": 1 },
        "login": { "type": "boolean" },
        "tmux": { "type": "boolean" }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["orbstack", "docker-desktop", "other", "auto"] }
      }
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": { "enum": ["agent-browser", "playwright", "both"] }
      }
    },
    "relay": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": { "type": "integer" },
        "controlPlaneUrl": { "type": "string" },
        "custodyMaxBodyBytes": { "type": "integer" },
        "custodyMaxBlobBytes": { "type": "integer" },
        "hostReachTimeoutMs": { "type": "integer" }
      }
    },
    "ssh": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "autoConfig": { "type": "boolean" }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pushMode": { "enum": ["auto", "relay", "lease", "direct"] }
      }
    },
    "hub": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gitAuth": { "enum": ["gh", "app"] },
        "mode": { "enum": ["auto", "thin", "local"] }
      }
    },
    "cloud": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "useCurrentBranch": { "type": "boolean" },
        "viaHub": { "type": "boolean" }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gh": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" }
          }
        }
      }
    },
    "vnc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "containerPort": { "type": "integer" }
      }
    },
    "portless": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "stateDir": { "type": "string", "minLength": 1 }
      }
    },
    "autopause": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "maxRunningBoxes": { "type": "integer" },
        "idleMinutes": { "type": "integer" }
      }
    },
    "queue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "maxConcurrent": { "type": "integer" },
        "maxWorking": { "type": "integer" },
        "idleGraceSeconds": { "type": "integer" },
        "openIn": { "enum": ["none", "split", "window", "tab"] }
      }
    },
    "maintenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pruneProjectConfigs": { "type": "boolean" },
        "pruneProjectConfigsEvery": { "type": "integer" }
      }
    },
    "update": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "check": { "type": "boolean" },
        "channel": { "enum": ["auto", "stable", "nightly"] }
      }
    }
  }
}
