TERM_CMD='xterm -fa Monospace -fs 11 -bg black -fg white'
# agent-browser, not a raw chromium: it is the session-managed path the rest of
# agentbox drives (`agentbox screen` -> ensureBoxBrowserShowingApp), so the dock
# opens a browser the host already knows how to talk to.
#
# Its own `desktop` session, NOT the agent's `default` one: a bare
# `agent-browser open` against a live session navigates that page to about:blank
# (verified), which would yank the page out from under a working agent -- the
# exact thing `agentbox screen` takes care not to do. A separate session gives
# the person at the desktop their own window and leaves the agent's alone; the
# agent's browser is already one click away in the dock when it is running.
BROWSER_CMD='agent-browser --session desktop open --headed'

write_jwmrc() {
  local term_button browser_button include_local
  write_dock_icons || true

  # Icon-only buttons: the tooltip carries the name, so a text label would just
  # be clutter next to the running-window icons. A label is the fallback only if
  # the icon failed to land (no base64, read-only home).
  if [[ -s "$DOCK_ICON_DIR/terminal.png" ]]; then
    term_button="<TrayButton popup=\"Terminal\" icon=\"$DOCK_ICON_DIR/terminal.png\">exec:$TERM_CMD</TrayButton>"
  else
    term_button="<TrayButton popup=\"Terminal\" label=\"Term\">exec:$TERM_CMD</TrayButton>"
  fi
  if [[ -s "$DOCK_ICON_DIR/browser.png" ]]; then
    browser_button="<TrayButton popup=\"Browser\" icon=\"$DOCK_ICON_DIR/browser.png\">exec:$BROWSER_CMD</TrayButton>"
  else
    browser_button="<TrayButton popup=\"Browser\" label=\"Web\">exec:$BROWSER_CMD</TrayButton>"
  fi

  # Emitted only when it exists: JWM warns on a missing include, and this file
  # is regenerated on every start, so creating it and restarting picks it up.
  include_local=""
  if [[ -e "$HOME/.jwmrc.local" ]]; then
    include_local="<Include>$HOME/.jwmrc.local</Include>"
  fi

  cat > "$HOME/.jwmrc" <<JWMRC
<?xml version="1.0"?>
<!-- Generated by agentbox-vnc-start on every VNC start. Edits here are
     overwritten; put your own JWM config in ~/.jwmrc.local, included below. -->
<JWM>
  <!-- One desktop. Extra desktops in a single-window VNC view only lose windows
       behind a shortcut nobody knew they pressed. -->
  <Desktops width="1" height="1"/>

  <!-- The dock: a fixed-width strip centered on the bottom edge. The explicit
       width is load-bearing, because JWM honors halign only on a sized tray and
       an unsized horizontal tray spans the screen (a taskbar, not a dock). JWM
       cannot size a tray to its contents, so 240 is a compromise: snug for the
       two launchers plus the one or two windows a box usually has, and the
       TaskList shrinks its icons rather than overflowing beyond that. -->
  <Tray valign="bottom" halign="center" width="240" height="48" border="0" autohide="off" layer="above">
    $term_button
    $browser_button
    <!-- labeled="false" makes these icon-only buttons, and the icons come free
         from each window's own _NET_WM_ICON, so nothing needs shipping. -->
    <TaskList labeled="false" maxwidth="48"/>
  </Tray>

  <TrayStyle decorations="flat">
    <Font>Sans-9</Font>
    <Background>#1c1c1e</Background>
    <Foreground>#e8e8ed</Foreground>
    <Opacity>0.88</Opacity>
  </TrayStyle>

  <TaskListStyle>
    <Font>Sans-9</Font>
    <Background>#1c1c1e</Background>
    <Foreground>#e8e8ed</Foreground>
    <Active>
      <Background>#3a3a3d</Background>
      <Foreground>#ffffff</Foreground>
    </Active>
  </TaskListStyle>

  <WindowStyle decorations="flat">
    <Font>Sans-9</Font>
    <Width>3</Width>
    <Height>22</Height>
    <Background>#2a2a2d</Background>
    <Foreground>#9a9aa0</Foreground>
    <Outline>#141416</Outline>
    <Active>
      <Background>#3a3a3d</Background>
      <Foreground>#ffffff</Foreground>
      <Outline>#141416</Outline>
    </Active>
  </WindowStyle>

  <MenuStyle decorations="flat">
    <Font>Sans-9</Font>
    <Background>#1c1c1e</Background>
    <Foreground>#e8e8ed</Foreground>
    <Outline>#141416</Outline>
    <Active>
      <Background>#3a3a3d</Background>
      <Foreground>#ffffff</Foreground>
    </Active>
  </MenuStyle>

  <!-- Keep the screen-launched browser filling the desktop the way it did when
       there was no WM at all, now minus the dock's strut. Playwright's Chromium
       (what agent-browser drives) reports WM_CLASS "Chromium-browser"; the other
       two are what a distro chromium and a real Chrome report. JWM matches the
       class exactly, so each spelling needs its own Group. -->
  <Group>
    <Class>Chromium-browser</Class>
    <Option>maximized</Option>
  </Group>
  <Group>
    <Class>Chromium</Class>
    <Option>maximized</Option>
  </Group>
  <Group>
    <Class>Google-chrome</Class>
    <Option>maximized</Option>
  </Group>

  <RootMenu onroot="123">
    <Program label="Terminal" icon="$DOCK_ICON_DIR/terminal.png">$TERM_CMD</Program>
    <Program label="Browser" icon="$DOCK_ICON_DIR/browser.png">$BROWSER_CMD</Program>
    <Separator/>
    <Restart label="Restart JWM"/>
  </RootMenu>

  <!-- This file replaces the system config, so no key bindings are inherited;
       the two a person actually reaches for are spelled out here. -->
  <Key mask="A" key="Tab">nextstacked</Key>
  <Key mask="A" key="F4">close</Key>

  $include_local
</JWM>
JWMRC
}

# `jwm -p` parses the config and exits, so a config JWM would choke on becomes
# a log line here instead of a window manager that dies mid-session.
if command -v jwm >/dev/null 2>&1; then
  write_jwmrc
  if jwm -p -f "$HOME/.jwmrc" >/dev/null 2>&1; then
    if ! pgrep -u "$(id -u)" -x jwm >/dev/null; then
      DISPLAY=:1 jwm >>/var/log/agentbox/jwm.log 2>&1 &
    fi
  else
    echo "agentbox-vnc-start: generated ~/.jwmrc did not pass 'jwm -p'; leaving the desktop without a window manager" >&2
  fi
fi

# JWM manages windows but, like most lightweight WMs, it does not own the X
# selections, so Xvnc's RFB cut-text still isn't reliably handed to Chromium on
# Ctrl+V. autocutsel (one daemon per selection) keeps CLIPBOARD and PRIMARY
# populated and synced. Best-effort: a clipboard failure must never abort VNC,
# and the pgrep guard keeps a stray re-entry from spawning duplicates (Xvnc is
# up now, so DISPLAY=:1 resolves).
if ! pgrep -u "$(id -u)" -x autocutsel >/dev/null; then
  DISPLAY=:1 autocutsel -selection CLIPBOARD -fork >/dev/null 2>&1 || true
  DISPLAY=:1 autocutsel -selection PRIMARY -fork >/dev/null 2>&1 || true
fi

# noVNC's static assets live at different paths per base image: Debian/Ubuntu
# (docker, hetzner) ship them at /usr/share/novnc via apt; the AL2023 bake
# (vercel) git-clones them to /usr/local/share/novnc. websockify runs
# os.chdir(--web) at startup, so a wrong path makes it FileNotFoundError and
# never bind 6080 — pick the first dir that exists.
NOVNC_WEB=""
for _d in /usr/share/novnc /usr/local/share/novnc; do
  if [[ -d "$_d" ]]; then NOVNC_WEB="$_d"; break; fi
done
if [[ -z "$NOVNC_WEB" ]]; then
  echo "agentbox-vnc-start: noVNC assets not found (looked in /usr/share/novnc, /usr/local/share/novnc)" >&2
  exit 65
fi

# websockify serves noVNC at /vnc.html (--web) and tunnels WS frames to Xvnc's
# RFB. Bind 0.0.0.0:6080 so both Docker `-p` mappings and OrbStack's
# <name>.orb.local routing reach it.
websockify \
  --web="$NOVNC_WEB" \
  0.0.0.0:6080 \
  127.0.0.1:5901 \
  >/var/log/agentbox/websockify.log 2>&1 &

disown -a
