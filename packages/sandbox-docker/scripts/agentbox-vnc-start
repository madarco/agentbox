# The dock's Browser button and the host's "show the app on the VNC screen" step
# both go through this launcher instead of calling agent-browser directly. The
# first Chromium launch in a box is a Playwright download (~150MB, tens of
# seconds; see chromium-resolver on why nothing is baked), and JWM has no
# startup notification -- no busy cursor, no bouncing icon -- so a direct exec
# leaves a person staring at an empty desktop with no sign anything is
# happening. The launcher maps an xterm immediately, which is both the progress
# window and, through the TaskList, the dock's loading indicator; it closes
# itself the moment the browser is up, and stays with the error when it is not.
#
# Written here rather than shipped as its own file for the same reason the icons
# are: this script is the one runtime asset every provider already installs.
# Its path is stable ($HOME/.local/share/agentbox/desktop/open-browser) so the
# host side can call it too, and it exists exactly when VNC is up.
write_desktop_launcher() {
  mkdir -p "$DESKTOP_ASSET_DIR" 2>/dev/null || return 1
  cat > "$DESKTOP_LAUNCHER" <<'LAUNCHER'
#!/usr/bin/env bash
# agentbox: open the in-box browser on the VNC desktop, with visible progress.
# Generated by agentbox-vnc-start on every VNC start -- edits here are lost.
#
# usage: open-browser [--session NAME] [URL]
set -uo pipefail

session="default"
url="about:blank"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --session) session="${2:-default}"; shift 2 ;;
    --) shift ;;
    *) url="$1"; shift ;;
  esac
done

# The desktop is always :1; an inherited DISPLAY wins so this stays usable from
# a terminal on another display.
export DISPLAY="${DISPLAY:-:1}"

# One launch in flight per session: the dock button and the host-side open-VNC
# step can fire at the same moment, and two `agent-browser open` runs against
# one session race over the same profile (and would stack two progress windows).
# Every agent-browser call below closes fd 9 (`9>&-`): the browser it starts is
# a DAEMON that outlives this script, and an inherited lock fd would keep the
# lock held for the life of that daemon -- every later click then finds the lock
# taken and does nothing at all.
lock="${TMPDIR:-/tmp}/agentbox-open-browser.$session.lock"
# The braces scope the 2>/dev/null to the exec (an unwritable /tmp is not worth
# a message) while fd 9 itself stays open for the rest of the script; a plain
# `exec 9>... 2>/dev/null` would silence every later error too.
lock_open=0
{ exec 9>"$lock"; } 2>/dev/null && lock_open=1
if [[ $lock_open -eq 1 ]] && ! flock -n 9; then
  exit 0
fi

# No xterm (an image baked before the desktop work): nothing to draw progress
# in, so just do the launch the old way.
if ! command -v xterm >/dev/null 2>&1; then
  exec agent-browser --session "$session" open --headed "$url" 9>&-
fi

# The window sits low on the desktop -- horizontally centred, its middle about
# three quarters down -- so the logo on the wallpaper stays visible above it
# while the browser starts. JWM can only centre a window, so the position is
# computed: this geometry is the guess for the desktop as agentbox-vnc-start
# starts it (Xvnc at 1280x800, where Monospace 11 measures 9x18 px per cell,
# plus xterm's 2px internal border per side), and the window re-centres itself
# from its real measurements once it is up -- see place_window below.
cols=64
rows=9
win_w=$(( cols * 9 + 4 ))
win_h=$(( rows * 18 + 4 ))
pos_x=$(( (1280 - win_w) / 2 ))
pos_y=$(( 800 * 3 / 4 - win_h / 2 ))

exec xterm \
  -name agentbox-launch \
  -title "Starting browser" \
  -geometry "${cols}x${rows}+${pos_x}+${pos_y}" \
  -xrm "XTerm*allowWindowOps:true" \
  -fa Monospace -fs 11 -bg "#1c1c1e" -fg "#e8e8ed" \
  -e bash -c '
set -uo pipefail
session="$1"; url="$2"

# Centre the window horizontally and put its middle three quarters down the
# screen, whatever the desktop actually measures -- the -geometry above is only
# a guess at both sizes, and a viewer can resize the screen under us (noVNC
# remote resize). The image ships no xdpyinfo/xwininfo/xdotool, so the terminal
# is asked about itself: xterm reports the screen size (CSI 15 t) and its own
# text area (CSI 14 t), and moves itself (CSI 3 t) -- all three need the
# allowWindowOps resource set on the xterm above. A terminal that answers
# neither query leaves the window on its guessed geometry.
tty=/dev/tty
place_window() {
  local saved scr win re_scr re_win sw sh ww wh
  saved="$(stty -g <"$tty" 2>/dev/null)" || return 0
  stty -echo -icanon min 0 time 2 <"$tty" 2>/dev/null || return 0
  printf "\033[15t" >"$tty"
  IFS= read -r -t 1 -d t scr <"$tty"
  printf "\033[14t" >"$tty"
  IFS= read -r -t 1 -d t win <"$tty"
  stty "$saved" <"$tty" 2>/dev/null
  re_scr="5;([0-9]+);([0-9]+)"
  re_win="4;([0-9]+);([0-9]+)"
  [[ $scr =~ $re_scr ]] || return 0
  sh="${BASH_REMATCH[1]}"; sw="${BASH_REMATCH[2]}"
  [[ $win =~ $re_win ]] || return 0
  wh="${BASH_REMATCH[1]}"; ww="${BASH_REMATCH[2]}"
  printf "\033[3;%d;%dt" "$(( (sw - ww) / 2 ))" "$(( sh * 3 / 4 - wh / 2 ))" >"$tty"
}
place_window

log="$(mktemp)"
agent-browser --session "$session" open --headed "$url" >"$log" 2>&1 9>&- &
pid=$!
printf "\n  Starting the browser on this desktop.\n"
printf "  The first launch downloads Chromium and can take a minute.\n\n"
frames="|/-\\"
i=0
start=$SECONDS
rc=""
done_at=0
while :; do
  if [[ -z $rc ]] && ! kill -0 "$pid" 2>/dev/null; then
    wait "$pid"; rc=$?
    done_at=$SECONDS
    [[ $rc -ne 0 ]] && break
  fi
  # The command exiting is NOT the browser being on screen: agent-browser hands
  # the request to its daemon and returns in milliseconds whenever one is
  # already up. Wait for the Chromium itself -- the CDP flag is how every
  # agent-browser launch spells it, and the lazy chromium-resolver wrapper
  # ("/chromium ") is deliberately not matched, since seeing it means the
  # download this window exists for is still running. Give up waiting 25s after
  # the launch returned, so an unrecognised browser closes the window instead of
  # stranding it.
  if [[ -n $rc ]]; then
    if pgrep -f "/chrome .*--remote-debugging-port" >/dev/null 2>&1; then
      sleep 1
      exit 0
    fi
    [[ $((SECONDS - done_at)) -ge 25 ]] && exit 0
  fi
  # Playwright draws its download bar with carriage returns, so the real
  # progress is the last CR-separated chunk; cut keeps a redraw from wrapping.
  line="$(tr "\r" "\n" < "$log" | tail -n 1 | cut -c1-44)"
  printf "\r  %s %4ds  %-44s" "${frames:i++%4:1}" "$((SECONDS - start))" "$line"
  sleep 0.2
done
printf "\r  Browser failed to start (exit %d).%30s\n\n" "$rc" ""
tail -n 12 "$log"
printf "\n  Press Enter to close.\n"
read -r _
' agentbox-open-browser "$session" "$url"
LAUNCHER
  chmod 755 "$DESKTOP_LAUNCHER" 2>/dev/null || return 1
}

# The desktop terminal is ink on paper, not white on black: it opens over the
# AgentBox wallpaper, and #f5f3f0 is that wallpaper's own paper colour (palette
# entry 0 of the PNG above), the same one the dock and the window titlebars
# paint. The ANSI palette has to come with it -- xterm's default sixteen are
# picked for a black background, and the bright ones (yellow, cyan, white) are
# unreadable on paper, with "bright white" invisible. These are the paper-theme
# equivalents: darker, desaturated, and 7/15 mapped to grey/ink so anything a
# prompt draws in white still reads. #-values must be quoted for -bg/-fg/-cr
# (the shell JWM spawns would take a word-initial # as a comment) but not for
# the -xrm specs, where the # sits mid-word.
TERM_COLORS='-xrm XTerm.vt100.color0:#1d1e20 -xrm XTerm.vt100.color1:#b4271f'
TERM_COLORS="$TERM_COLORS -xrm XTerm.vt100.color2:#2c7a39 -xrm XTerm.vt100.color3:#96690c"
TERM_COLORS="$TERM_COLORS -xrm XTerm.vt100.color4:#2359b5 -xrm XTerm.vt100.color5:#8a3fa0"
TERM_COLORS="$TERM_COLORS -xrm XTerm.vt100.color6:#1a7b86 -xrm XTerm.vt100.color7:#4a4b4f"
TERM_COLORS="$TERM_COLORS -xrm XTerm.vt100.color8:#7a7b7f -xrm XTerm.vt100.color9:#d0392c"
TERM_COLORS="$TERM_COLORS -xrm XTerm.vt100.color10:#37934a -xrm XTerm.vt100.color11:#b0801a"
TERM_COLORS="$TERM_COLORS -xrm XTerm.vt100.color12:#3670d6 -xrm XTerm.vt100.color13:#a154b8"
TERM_COLORS="$TERM_COLORS -xrm XTerm.vt100.color14:#23929e -xrm XTerm.vt100.color15:#1d1e20"
TERM_CMD='xterm -name agentbox-term -fa Monospace -fs 11 -bg "#f5f3f0" -fg "#1d1e20" -cr "#1d1e20"'
TERM_CMD="$TERM_CMD $TERM_COLORS"
# agent-browser, not a raw chromium: it is the session-managed path the rest of
# agentbox drives (`agentbox screen` -> ensureBoxBrowserShowingApp), so the dock
# opens a browser the host already knows how to talk to.
#
# Its own `desktop` session, NOT the agent's `default` one: a bare
# `agent-browser open` against a live session navigates that page to about:blank
# (verified), which would yank the page out from under a working agent -- the
# exact thing `agentbox screen` takes care not to do. A separate session gives
# the person at the desktop their own window and leaves the agent's alone; the
# agent's browser is already one click away in the dock when it is running.
# open-browser (written above) wraps that call in a progress window; this bare
# form is the fallback for a box whose home dir refused the write.
BROWSER_CMD='agent-browser --session desktop open --headed'

write_jwmrc() {
  local term_button browser_button background include_local browser_cmd
  write_desktop_assets || true
  write_desktop_launcher || true

  browser_cmd="$BROWSER_CMD"
  if [[ -x "$DESKTOP_LAUNCHER" ]]; then
    browser_cmd="$DESKTOP_LAUNCHER --session desktop"
  fi

  # Icon-only buttons: the tooltip carries the name, so a text label would just
  # be clutter next to the running-window icons. A label is the fallback only if
  # the icon failed to land (no base64, read-only home).
  if [[ -s "$DESKTOP_ASSET_DIR/terminal.png" ]]; then
    term_button="<TrayButton popup=\"Terminal\" icon=\"$DESKTOP_ASSET_DIR/terminal.png\">exec:$TERM_CMD</TrayButton>"
  else
    term_button="<TrayButton popup=\"Terminal\" label=\"Term\">exec:$TERM_CMD</TrayButton>"
  fi
  if [[ -s "$DESKTOP_ASSET_DIR/browser.png" ]]; then
    browser_button="<TrayButton popup=\"Browser\" icon=\"$DESKTOP_ASSET_DIR/browser.png\">exec:$browser_cmd</TrayButton>"
  else
    browser_button="<TrayButton popup=\"Browser\" label=\"Web\">exec:$browser_cmd</TrayButton>"
  fi

  if [[ -s "$DESKTOP_ASSET_DIR/wallpaper.png" ]]; then
    background="<Background type=\"tile\">$DESKTOP_ASSET_DIR/wallpaper.png</Background>"
  else
    background="<Background type=\"solid\">#f5f3f0</Background>"
  fi

  # Emitted only when it exists: JWM warns on a missing include, and this file
  # is regenerated on every start, so creating it and restarting picks it up.
  include_local=""
  if [[ -e "$HOME/.jwmrc.local" ]]; then
    include_local="<Include>$HOME/.jwmrc.local</Include>"
  fi

  # Unquoted delimiter -- the config interpolates the paths and commands probed
  # above -- so NOTHING in this body may contain a backtick or $(...), comments
  # included: bash runs it. A blocking one (`xterm ...` in a comment, once) hangs
  # the heredoc and with it the whole VNC start. Backticks are guarded by a test.
  cat > "$HOME/.jwmrc" <<JWMRC
<?xml version="1.0"?>
<!-- Generated by agentbox-vnc-start on every VNC start. Edits here are
     overwritten; put your own JWM config in ~/.jwmrc.local, included below. -->
<JWM>
  <!-- One desktop. Extra desktops in a single-window VNC view only lose windows
       behind a shortcut nobody knew they pressed.
       "tile", not "scale", because the screen is not fixed at the Xvnc geometry
       -- a noVNC viewer can resize it to the browser window, and then the
       screen's aspect ratio is the browser's. JWM's "scale" is not a stretch
       but an aspect-preserving fit (verified: a 32:10 image on a 16:10 screen
       filled the width and left black above and below), and "center" fits the
       same way, so every aspect but the wallpaper's own gets black bars, at any
       image size. Tiling is the one mode that neither scales nor letterboxes:
       the wallpaper is a 3840x2400 sheet of paper with the logo drawn in its
       top-left 1280x800, so at the Xvnc geometry the logo is centred as before,
       and every larger screen is covered edge to edge in paper with the logo
       where it has always been. Only past 3840x2400 does the sheet repeat, and
       what repeats is paper. The solid fallback keeps the brand paper colour on
       a box where the image could not be written, instead of a black void. -->
  <Desktops width="1" height="1">
    $background
  </Desktops>

  <!-- The dock: a fixed-width strip centered on the bottom edge. The explicit
       width is load-bearing, because JWM honors halign only on a sized tray and
       an unsized horizontal tray spans the screen (a taskbar, not a dock). JWM
       cannot size a tray to its contents, so 240 is a compromise: snug for the
       two launchers plus the one or two windows a box usually has, and the
       TaskList shrinks its icons rather than overflowing beyond that. -->
  <Tray valign="bottom" halign="center" width="240" height="48" border="0" autohide="off" layer="above">
    $term_button
    $browser_button
    <!-- labeled="false" makes these icon-only buttons, and the icons come free
         from each window's own _NET_WM_ICON, so nothing needs shipping. -->
    <TaskList labeled="false" maxwidth="48"/>
  </Tray>

  <!-- The dock paints the wallpaper's own paper colour (#f5f3f0 is palette entry
       0 of the PNG below, and the strip it sits on is flat paper), so it reads
       as free-floating icons rather than a slab across the desktop. Matching the
       colour is the only way to get that look: JWM ships no compositor, so its
       Opacity is inert unless a picom/xcompmgr is added -- which on a software
       VNC framebuffer buys repaint churn and nothing else. The window-hover and
       active tints are the wallpaper's own next two greys, so the dock stays in
       the same palette as everything behind it. -->
  <TrayStyle decorations="flat">
    <Font>Sans-9</Font>
    <Background>#f5f3f0</Background>
    <Foreground>#1d1e20</Foreground>
    <!-- Paper, not a colour: JWM draws the tray edge in the outline colour even
         at border="0", and a 240px rectangle on the wallpaper is exactly the
         slab this style exists to get rid of. -->
    <Outline>#f5f3f0</Outline>
  </TrayStyle>

  <TaskListStyle>
    <Font>Sans-9</Font>
    <Background>#f5f3f0</Background>
    <Foreground>#1d1e20</Foreground>
    <Outline>#f5f3f0</Outline>
    <Active>
      <Background>#e1e0df</Background>
      <Foreground>#111213</Foreground>
      <Outline>#e1e0df</Outline>
    </Active>
  </TaskListStyle>

  <!-- Titlebars in the same paper palette as the dock: the focused one is the
       wallpaper's own #f5f3f0, so a window's chrome reads as part of the
       desktop rather than a dark bar dropped on it, and an unfocused one is the
       next grey down. The browser and the launch card are undecorated (below),
       so in practice this dresses the terminal. -->
  <WindowStyle decorations="flat">
    <Font>Sans-9</Font>
    <Width>3</Width>
    <Height>22</Height>
    <Background>#e9e7e4</Background>
    <Foreground>#6b6c70</Foreground>
    <Outline>#e1e0df</Outline>
    <Active>
      <Background>#f5f3f0</Background>
      <Foreground>#1d1e20</Foreground>
      <Outline>#e1e0df</Outline>
    </Active>
  </WindowStyle>

  <MenuStyle decorations="flat">
    <Font>Sans-9</Font>
    <Background>#1c1c1e</Background>
    <Foreground>#e8e8ed</Foreground>
    <Outline>#141416</Outline>
    <Active>
      <Background>#3a3a3d</Background>
      <Foreground>#ffffff</Foreground>
    </Active>
  </MenuStyle>

  <!-- Keep the screen-launched browser filling the desktop the way it did when
       there was no WM at all, now minus the dock's strut. Playwright's Chromium
       (what agent-browser drives) reports WM_CLASS "Chromium-browser"; the other
       two are what a distro chromium and a real Chrome report. JWM matches the
       class exactly, so each spelling needs its own Group.
       Undecorated: on a 800px-tall desktop a titlebar over a browser that is
       always maximized is ~30px of page spent on a second title above the one
       the tab strip already shows. The dock entry (right-click for the window
       menu) is how the window is raised and closed instead. -->
  <!-- The launcher's progress window (an xterm named agentbox-launch). It borrows
       the Browser icon so the dock entry that appears while Chromium starts is
       the browser's own -- the closest thing JWM has to a launch indicator, as
       it implements no startup notification. Above the layer the browser
       maximizes into, so a re-launch over a running window is still visible.
       Its position is the launcher's own (JWM honours it): low on the screen,
       clear of the logo on the wallpaper.
       Undecorated -- no titlebar, no border: it is a transient status card, not
       a window to manage, and the buttons on it did nothing worth clicking (the
       one case where it stays, a failed launch, closes on Enter and says so).
       It keeps its dock entry, which is how it is raised and what shows a launch
       is running. -->
  <!-- The terminal's own dock icon: a window carries whatever _NET_WM_ICON it
       sets, and xterm's is a 1990s X bitmap that has nothing to do with the
       Terminal button that opened it. -->
  <Group>
    <Name>agentbox-term</Name>
    <Option>icon:$DESKTOP_ASSET_DIR/terminal.png</Option>
  </Group>

  <Group>
    <Name>agentbox-launch</Name>
    <Option>icon:$DESKTOP_ASSET_DIR/browser.png</Option>
    <Option>notitle</Option>
    <Option>noborder</Option>
    <Option>nomax</Option>
    <Option>layer:above</Option>
  </Group>

  <Group>
    <Class>Chromium-browser</Class>
    <Option>notitle</Option>
    <Option>noborder</Option>
    <Option>maximized</Option>
  </Group>
  <Group>
    <Class>Chromium</Class>
    <Option>notitle</Option>
    <Option>noborder</Option>
    <Option>maximized</Option>
  </Group>
  <Group>
    <Class>Google-chrome</Class>
    <Option>notitle</Option>
    <Option>noborder</Option>
    <Option>maximized</Option>
  </Group>

  <RootMenu onroot="123">
    <Program label="Terminal" icon="$DESKTOP_ASSET_DIR/terminal.png">$TERM_CMD</Program>
    <Program label="Browser" icon="$DESKTOP_ASSET_DIR/browser.png">$browser_cmd</Program>
    <Separator/>
    <Restart label="Restart JWM"/>
  </RootMenu>

  <!-- This file replaces the system config, so no key bindings are inherited;
       the two a person actually reaches for are spelled out here. -->
  <Key mask="A" key="Tab">nextstacked</Key>
  <Key mask="A" key="F4">close</Key>

  $include_local
</JWM>
JWMRC
}

# `jwm -p` parses the config and exits, so a config JWM would choke on becomes
# a log line here instead of a window manager that dies mid-session.
if command -v jwm >/dev/null 2>&1; then
  write_jwmrc
  if jwm -p -f "$HOME/.jwmrc" >/dev/null 2>&1; then
    if ! pgrep -u "$(id -u)" -x jwm >/dev/null; then
      DISPLAY=:1 jwm >>/var/log/agentbox/jwm.log 2>&1 &
    fi
  else
    echo "agentbox-vnc-start: generated ~/.jwmrc did not pass 'jwm -p'; leaving the desktop without a window manager" >&2
  fi
fi

# JWM manages windows but, like most lightweight WMs, it does not own the X
# selections, so Xvnc's RFB cut-text still isn't reliably handed to Chromium on
# Ctrl+V. autocutsel (one daemon per selection) keeps CLIPBOARD and PRIMARY
# populated and synced. Best-effort: a clipboard failure must never abort VNC,
# and the pgrep guard keeps a stray re-entry from spawning duplicates (Xvnc is
# up now, so DISPLAY=:1 resolves).
if ! pgrep -u "$(id -u)" -x autocutsel >/dev/null; then
  DISPLAY=:1 autocutsel -selection CLIPBOARD -fork >/dev/null 2>&1 || true
  DISPLAY=:1 autocutsel -selection PRIMARY -fork >/dev/null 2>&1 || true
fi

# noVNC's static assets live at different paths per base image: Debian/Ubuntu
# (docker, hetzner) ship them at /usr/share/novnc via apt; the AL2023 bake
# (vercel) git-clones them to /usr/local/share/novnc. websockify runs
# os.chdir(--web) at startup, so a wrong path makes it FileNotFoundError and
# never bind 6080 — pick the first dir that exists.
NOVNC_WEB=""
for _d in /usr/share/novnc /usr/local/share/novnc; do
  if [[ -d "$_d" ]]; then NOVNC_WEB="$_d"; break; fi
done
if [[ -z "$NOVNC_WEB" ]]; then
  echo "agentbox-vnc-start: noVNC assets not found (looked in /usr/share/novnc, /usr/local/share/novnc)" >&2
  exit 65
fi

# websockify serves noVNC at /vnc.html (--web) and tunnels WS frames to Xvnc's
# RFB. Bind 0.0.0.0:6080 so both Docker `-p` mappings and OrbStack's
# <name>.orb.local routing reach it.
websockify \
  --web="$NOVNC_WEB" \
  0.0.0.0:6080 \
  127.0.0.1:5901 \
  >/var/log/agentbox/websockify.log 2>&1 &

disown -a
