#!/usr/bin/env bash
# Start the per-box VNC stack: Xvnc on :1 (loopback inside container), JWM
# (window manager + bottom dock) on that display, and websockify on
# 0.0.0.0:6080 serving noVNC's HTML5 client and proxying RFB.
# Launched by the host via `docker exec -d --user vscode` after the container
# is up. Idempotent — re-running while the daemons are alive is a no-op, so
# `agentbox start` can blindly call us again. That same guard means a box whose
# Xvnc is already up does not pick up a newly-baked window manager until it
# restarts — `agentbox stop && agentbox start` is the fix.

set -euo pipefail

PASS="${AGENTBOX_VNC_PASSWORD:-}"
if [[ -z "$PASS" ]]; then
  echo "agentbox-vnc-start: AGENTBOX_VNC_PASSWORD is not set" >&2
  exit 64
fi

if pgrep -u "$(id -u)" -x Xvnc >/dev/null \
   && pgrep -u "$(id -u)" -f "websockify.*6080" >/dev/null; then
  exit 0
fi

mkdir -p "$HOME/.vnc"
# vncpasswd's -f mode reads plaintext on stdin, writes the DES blob to stdout.
# VncAuth truncates >8 chars at compare time, which is fine — the host writes
# an 8-char password. Write to a temp file + rename so a failure (e.g.,
# vncpasswd missing) doesn't leave an empty file that Xvnc would then reject.
#
# Debian 12 (E2B base) doesn't package vncpasswd at all — tigervnc-tools is
# Ubuntu-only. When vncpasswd is missing, fall back to `-SecurityTypes None`
# and rely on the cloud provider's signed preview URL as the access boundary
# (same effective model: holding the URL = holding the credential). Other
# providers (docker, hetzner, daytona, vercel) keep VncAuth.
VNC_SECURITY_ARGS=(-SecurityTypes VncAuth -PasswordFile "$HOME/.vnc/passwd")
if command -v vncpasswd >/dev/null 2>&1; then
  TMP_PASSWD="$(mktemp "$HOME/.vnc/passwd.XXXXXX")"
  printf '%s\n' "$PASS" | vncpasswd -f > "$TMP_PASSWD"
  chmod 600 "$TMP_PASSWD"
  mv "$TMP_PASSWD" "$HOME/.vnc/passwd"
else
  echo "agentbox-vnc-start: vncpasswd not installed; starting Xvnc with -SecurityTypes None (preview URL is the access boundary)" >&2
  VNC_SECURITY_ARGS=(-SecurityTypes None)
fi

mkdir -p /var/log/agentbox 2>/dev/null || true

# Xvnc on display :1, loopback-only (websockify is the only public ingress).
# 1280x800x24 is a sensible laptop-browser viewport.
# The clipboard params are on-by-default in TigerVNC 1.13 but pinned here so a
# base-image bump can't silently break host->box paste, and to document intent:
# accept cut-text from noVNC, set both the X CLIPBOARD and PRIMARY selections.
Xvnc :1 \
  -localhost \
  "${VNC_SECURITY_ARGS[@]}" \
  -geometry 1280x800 \
  -depth 24 \
  -AlwaysShared \
  -AcceptCutText=1 \
  -SendCutText=1 \
  -SetPrimary=1 \
  -SendPrimary=1 \
  >/var/log/agentbox/xvnc.log 2>&1 &

# Wait for Xvnc's RFB socket (5901). bash's /dev/tcp pseudo-device makes the
# probe a one-liner without needing netcat in the image.
for _ in $(seq 1 50); do
  if (echo > /dev/tcp/127.0.0.1/5901) 2>/dev/null; then break; fi
  sleep 0.1
done

# Window manager + dock. JWM (~1MB) buys three things Xvnc alone cannot: windows
# that can be raised, moved and closed; an EWMH _NET_CLIENT_LIST so a dock can
# show what is running; and a place to launch a terminal from. Everything here
# is best-effort — a base image baked before JWM existed, or a config JWM
# refuses, must still leave a working (if bare) VNC screen behind.
#
# The config is generated here rather than shipped as its own file so it rides
# the one script every provider already installs, and so the icon paths can be
# probed on the box instead of hardcoded per base OS.
# The desktop's static assets -- two launcher icons and the wallpaper -- carried
# here as base64 rather than shipped as files: this script is the one runtime
# asset every provider already installs, so embedding them keeps the desktop out
# of the per-provider runtime-assets lists entirely. The wallpaper is a 16-colour
# indexed PNG at exactly the Xvnc geometry: flat paper plus sharp black glyphs is
# the case indexed PNG wins outright (4KB, vs 10KB for JPEG q60, which also rings
# around the letterforms) -- and the AL2023 source build of JWM has no jpeg
# support at all, only png. They also sidestep what the base
# images actually offer -- xterm's own pixmap is a 1990s bitmap of the letters
# "XTERM", and no base image ships a browser icon at all (Chromium arrives later
# via Playwright, under the box user's cache).
DESKTOP_ASSET_DIR="$HOME/.local/share/agentbox/desktop"
DESKTOP_LAUNCHER="$DESKTOP_ASSET_DIR/open-browser"

write_desktop_assets() {
  mkdir -p "$DESKTOP_ASSET_DIR" 2>/dev/null || return 1
  base64 -d > "$DESKTOP_ASSET_DIR/terminal.png" <<'ICON_TERMINAL'
