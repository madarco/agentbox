#!/usr/bin/env bash
# agentbox: resolve the browser that agent-browser drives.
#
# Two tiers, one entry point (`AGENT_BROWSER_EXECUTABLE_PATH=/usr/local/bin/chromium`
# points at this script, so every agent-browser launch runs it):
#
#   1. Full Google Chrome at /opt/google/chrome/chrome, baked into every x86_64
#      image (all cloud providers, docker on amd64). The box's VNC screen is a
#      real desktop the user looks at, and Playwright's linux-x64 "chromium" is
#      a Chrome for Testing build that paints a permanent "for testing only"
#      notice there. Real Chrome has no such notice; agent-browser drives it
#      over CDP with the same flags. Google ships no linux/arm64 Chrome, so
#      arm64 images (docker on Apple Silicon) never have this tier.
#
#   2. Playwright's Chromium, shared with the project. We deliberately do NOT
#      bake one: Playwright pins an exact build per playwright version, so a
#      baked browser goes stale the moment a project pins a different
#      Playwright — the project's `playwright install` then fetches a
#      *different* build, and anything waiting on the baked one (a hard-coded
#      ms-playwright path) hangs forever. Instead we reuse the *project's*
#      Playwright Chromium — the exact build its own tests use — so
#      agent-browser and Playwright share a single binary that is always
#      correct. Resolution is effectively cached: once a build exists the hot
#      path is just an `ls` + `exec` (no download).
#
#      a. newest installed Playwright Chromium under ~/.cache/ms-playwright; else
#      b. install one with the project's pinned Playwright (matching build), or
#         the box's global Playwright as a fallback when the project has none;
#      c. exec the real binary with the args agent-browser passed.
#
# Noble's chromium apt package is a snap stub, so Playwright's downloader stays
# the only reliable arm64 source — we just invoke it lazily, with the project's
# version, instead of baking a fixed one.

if [ -x /opt/google/chrome/chrome ]; then
  exec /opt/google/chrome/chrome "$@"
fi

newest_chrome() {
  ls -d "$HOME"/.cache/ms-playwright/chromium-*/chrome-linux*/chrome 2>/dev/null | sort -V | tail -1
}

real="$(newest_chrome)"
if [ -z "$real" ]; then
  echo "agentbox: no Chromium yet; installing via Playwright (one-time)..." >&2
  # Serialize concurrent first-launches: without a lock, two simultaneous
  # agent-browser launches would both run `playwright install` into the same
  # ~/.cache/ms-playwright, and one could exec a half-extracted binary. flock
  # makes the second waiter re-check the cache and skip the redundant install.
  mkdir -p "$HOME/.cache" 2>/dev/null
  exec 9>"$HOME/.cache/agentbox-chromium-install.lock"
  flock 9
  real="$(newest_chrome)" # another launch may have installed it while we waited
  if [ -z "$real" ]; then
    if [ -x /workspace/node_modules/.bin/playwright ]; then
      ( cd /workspace && ./node_modules/.bin/playwright install chromium ) >&2
    else
      playwright install chromium >&2
    fi
    real="$(newest_chrome)"
  fi
  flock -u 9
fi

if [ -z "$real" ] || [ ! -x "$real" ]; then
  echo "agentbox: could not resolve a Chromium binary (Playwright install failed?)." >&2
  exit 127
fi

exec "$real" "$@"
