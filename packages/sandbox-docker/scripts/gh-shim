#!/usr/bin/env bash
# agentbox `gh` shim — forwards the GitHub CLI to the host, so the host's
# authenticated `gh` runs the operation and only the result crosses back. The
# in-box agent never sees a GitHub token.
#
# The whole CLI is forwarded. An earlier version proxied a curated allowlist
# of subcommands and rejected the rest, which meant every new agent workflow
# (`gh issue`, `gh search`, `gh release`) hit "not proxied" and needed a code
# change to unblock — see issue #304. Policy now lives host-side in
# packages/relay/src/gh.ts as a small blocklist plus a short list of
# destructive ops that always confirm; everything else is allow-once.
#
# This shim is NOT the security boundary (see docs/architecture.md) — the
# relay is. What it does do is fix up argv the host could not get right on its
# own: `gh pr` subcommands resolve against the *current branch*, and the host's
# gh runs in the host checkout, not the box's worktree. Without injection a
# bare `gh pr view` in a box reports on whatever the host has checked out.

set -euo pipefail

# Paths are constants in production; env overrides exist purely to let unit
# tests substitute a stub `agentbox-ctl` on PATH without rewriting the shim.
CTL="${AGENTBOX_CTL_PATH:-/usr/local/bin/agentbox-ctl}"
REAL_GIT="${AGENTBOX_REAL_GIT_PATH:-/usr/bin/git}"

# Resolve the in-box current branch once, so `gh pr` commands carry the box's
# ref rather than falling back to the host's HEAD.
box_branch() {
  "$REAL_GIT" -C "$PWD" rev-parse --abbrev-ref HEAD 2>/dev/null || true
}

# Returns 0 if any element of "$@" equals "$1" (the needle).
needle_present() {
  local needle="$1"; shift
  local arg
  for arg in "$@"; do
    if [ "$arg" = "$needle" ]; then return 0; fi
  done
  return 1
}

# Returns the first true positional of "$@" (skipping flags AND their values),
# or '' if none. $1 is a `|`-separated list of value-taking flags for the
# current subcommand — without it we would treat `--json number,url`'s field
# list as the positional and skip branch injection (a real bug: PR-badge
# lookups returned "no PR for main").
first_positional() {
  local value_taking="$1"; shift
  local re="^(${value_taking})$"
  local arg
  local skip_value=0
  for arg in "$@"; do
    if [ "$skip_value" = "1" ]; then
      skip_value=0
      continue
    fi
    case "$arg" in
      --) ;;
      -*)
        if [[ -n "$value_taking" && "$arg" =~ $re ]]; then
          skip_value=1
        fi
        ;;
      *) printf '%s\n' "$arg"; return 0 ;;
    esac
  done
}

# `gh pr <op>` with no explicit ref resolves against the current branch. Inject
# the box's branch for the ops that behave that way. Everything else in the pr
# family (create, checkout, ...) is passed through untouched — `create` gets
# its `--head` injected host-side, where the sanctioned branch is known.
#
# Done inline with `set --` rather than through a helper that echoes an array:
# `mapfile` is bash 4+, and this file has to run under macOS's bash 3.2 in the
# unit tests as well as bash 5 in the box.
handle_pr() {
  local op="${1-}"
  [ -n "$op" ] || { exec "$CTL" gh exec -- pr; }
  shift
  local branch
  branch="$(box_branch)"

  if [ -n "$branch" ]; then
    case "$op" in
      view|diff|checks|comment|review|merge|close|reopen)
        # These take the ref as a positional. Skip known value-taking flags so
        # a flag's value is not mistaken for the ref.
        if [ -z "$(first_positional "--json|--body|--body-file|-b|-F|--color|--repo|-R" "$@")" ]; then
          set -- "$branch" "$@"
        fi
        ;;
      list)
        # `pr list` filters by head branch via a flag, not a positional.
        if ! needle_present "--head" "$@"; then
          set -- "$@" "--head" "$branch"
        fi
        ;;
    esac
  fi
  exec "$CTL" gh exec -- pr "$op" "$@"
}

# `gh repo clone` is the one subcommand that cannot be a plain host exec: the
# clone has to land INSIDE the box. The host clones with its credentials,
# bundles, and ships the bundle back, so it keeps its own ctl command and RPC.
handle_repo() {
  local op="${1-}"
  if [ "$op" != "clone" ]; then
    exec "$CTL" gh exec -- repo ${op:+"$op"} "${@:2}"
  fi
  shift
  # Split argv into (repo, dir, flags). Positionals go BEFORE options so
  # commander parses --branch/--depth as real options; a `--` separator would
  # force it to treat them as extra positionals.
  local repo='' dir=''
  local -a flags=()
  local pos=0
  local skip_value=0
  local arg
  for arg in "$@"; do
    if [ "$skip_value" = "1" ]; then
      flags+=("$arg")
      skip_value=0
      continue
    fi
    case "$arg" in
      --branch|--depth)
        flags+=("$arg")
        skip_value=1
        ;;
      -*) flags+=("$arg") ;;
      *)
        if [ $pos -eq 0 ]; then repo="$arg"
        elif [ $pos -eq 1 ]; then dir="$arg"
        else
          printf 'agentbox gh shim: too many positionals for '"'"'gh repo clone'"'"' (got %s after repo + dir)\n' "$arg" >&2
          exit 2
        fi
        pos=$((pos+1))
        ;;
    esac
  done
  if [ -z "$repo" ]; then
    printf "agentbox gh shim: 'gh repo clone' requires a positional <repo> (owner/name or full URL)\n" >&2
    exit 2
  fi
  if [ -n "$dir" ]; then
    exec "$CTL" gh repo clone "$repo" "$dir" ${flags[@]+"${flags[@]}"}
  else
    exec "$CTL" gh repo clone "$repo" ${flags[@]+"${flags[@]}"}
  fi
}

if [ $# -eq 0 ]; then
  exec "$CTL" gh exec --
fi

case "$1" in
  --version|-v)
    # Real gh prints "gh version X.Y.Z (date)". Tools that sniff for that
    # string succeed against the shim line too. Answered locally so version
    # probes don't round-trip to the host.
    printf 'gh version 2.0.0 (agentbox-shim)\n'
    printf 'https://github.com/cli/cli\n'
    exit 0
    ;;
  auth)
    # Answered locally: Claude Code polls `auth status` on a refresh loop, and
    # the real auth state is verified host-side on the next actual RPC (the
    # relay's assertGhReady returns exit 4 when the host is logged out). Every
    # other `gh auth` subcommand is refused by the relay's blocklist, since
    # the host owns its own credential.
    if [ "${2-}" = "status" ]; then
      printf 'agentbox gh shim: logged in to github.com (via agentbox host relay)\n' >&2
      exit 0
    fi
    ;;
  pr)
    shift
    handle_pr "$@"
    ;;
  repo)
    shift
    handle_repo "$@"
    ;;
esac

exec "$CTL" gh exec -- "$@"
